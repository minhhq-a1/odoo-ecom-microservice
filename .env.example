# ── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-32-chars-min
ADMIN_SECRET_TOKEN=change-me-admin-32-chars-min

# ── Dry-run ──────────────────────────────────────────────────────────────────
MIDDLEWARE_DRY_RUN=true

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://middleware:password@pgbouncer:6432/middleware_db
SYNC_DATABASE_URL=postgresql://middleware:password@pgbouncer:6432/middleware_db
# Leave commented to disable; uncomment + fill to enable a read replica.
# DATABASE_REPLICA_URL=postgresql+asyncpg://user:pass@replica-host:5432/db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Odoo ─────────────────────────────────────────────────────────────────────
ODOO_URL=https://your-odoo.example.com
ODOO_DB=your_db
ODOO_USER=api@example.com
ODOO_PASSWORD=your_api_key_here
ODOO_TIMEOUT=30

# ── Shopee ───────────────────────────────────────────────────────────────────
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_IS_SANDBOX=true
# Exact registered push/callback URL — used verbatim as the prefix of the
# webhook HMAC base string (push_url + raw_body). MUST match the Shopee
# partner console; if empty, all incoming pushes fail signature verification.
SHOPEE_WEBHOOK_URL=

# ── Alerts ───────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
SENTRY_DSN=

# ── Stock ────────────────────────────────────────────────────────────────────
DEFAULT_STOCK_BUFFER_PCT=10
DEFAULT_SHOPEE_ALLOCATION_PCT=100

# ── Price Sync ───────────────────────────────────────────────────────────────
PRICE_MASTER=platform
PRICE_SYNC_INTERVAL_HOURS=6

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_AUTO_CONFIRM_ORDER=true
ENABLE_STOCK_SYNC=true
ENABLE_POLLING_FALLBACK=true
ENABLE_RECONCILIATION=true
ENABLE_PRICE_SYNC=false
POLLING_INTERVAL_MINUTES=10

# ── Credential Encryption (Fernet, multi-key for rotation) ───────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEYS=

# ── Circuit Breaker ──────────────────────────────────────────────────────────
ODOO_CB_FAILURE_THRESHOLD=5
ODOO_CB_OPEN_TIMEOUT=60
