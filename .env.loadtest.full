ENVIRONMENT=test
LOG_LEVEL=WARNING
SECRET_KEY=loadtest-secret-key-do-not-use-prod
ADMIN_SECRET_TOKEN=loadtest-admin-token

MIDDLEWARE_DRY_RUN=true

# App reads via PgBouncer (transaction pool), migrations bypass to postgres direct.
DATABASE_URL=postgresql+asyncpg://middleware:password@pgbouncer:6432/middleware_db
SYNC_DATABASE_URL=postgresql://middleware:password@postgres:5432/middleware_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

ODOO_URL=http://localhost:9999
ODOO_DB=test
ODOO_USER=test
ODOO_PASSWORD=test
ODOO_TIMEOUT=5

SHOPEE_PARTNER_ID=1000
SHOPEE_PARTNER_KEY=loadtest_partner_key_xxx
SHOPEE_SHOP_ID=99999
SHOPEE_IS_SANDBOX=true

DEFAULT_STOCK_BUFFER_PCT=10
DEFAULT_SHOPEE_ALLOCATION_PCT=100

PRICE_MASTER=platform
PRICE_SYNC_INTERVAL_HOURS=6

ENABLE_AUTO_CONFIRM_ORDER=false
ENABLE_STOCK_SYNC=false
ENABLE_POLLING_FALLBACK=false
ENABLE_RECONCILIATION=false
ENABLE_PRICE_SYNC=false
POLLING_INTERVAL_MINUTES=10

CREDENTIAL_KEYS=
ODOO_CB_FAILURE_THRESHOLD=5
ODOO_CB_OPEN_TIMEOUT=60
